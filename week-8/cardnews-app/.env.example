# Cardnews server — copy to .env and fill in
#
# Supabase Postgres connection string (Connection pooling 권장)
# Project Settings → Database → Connection string → URI → 'Use connection pooling' on
# 형식: postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# 비밀번호에 / : @ & 같은 특수문자 있으면 URL 인코딩 필수 (/→%2F, &→%26, :→%3A 등)
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# ImageKit — 이미지 업로드/CDN/변환
# https://imagekit.io → 대시보드에서 발급
#   • Public Key: 대시보드 우상단 키 아이콘 → Developer → Public key (public_xxx...)
#   • Private Key: 같은 화면 Private key (private_xxx...) — 절대 클라이언트 노출 금지
#   • URL Endpoint: 대시보드 URL endpoint (https://ik.imagekit.io/<your-id>)
# ─────────────────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# API server port (dev: 3001)
PORT=3001
